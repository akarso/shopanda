package {{.Package}}

import (
	"fmt"
	"net/http"

	"github.com/akarso/shopanda/internal/platform/plugin"
)

// Plugin is the {{.Slug}} product external plugin (scaffolded by product-init).
type Plugin struct{}

// New returns the {{.Slug}} plugin.
func New() *Plugin { return &Plugin{} }

// Name is the stable plugin identity and Migrator namespace.
func (p *Plugin) Name() string { return "{{.PluginName}}" }

// Init registers HTTP routes and optional sync jobs. Enablement is compile-time
// registration in cmd/api/register_plugins.go (add a config flag when ready).
func (p *Plugin) Init(app *plugin.App) error {
	if app == nil {
		return fmt.Errorf("{{.Slug}} plugin: app not configured")
	}
	if err := app.RegisterPublicRoute("GET /api/{{.Slug}}/health", http.HandlerFunc(health)); err != nil {
		return fmt.Errorf("{{.Slug}} plugin: health route: %w", err)
	}
	return nil
}

func health(w http.ResponseWriter, _ *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusOK)
	_, _ = w.Write([]byte(`{"status":"ok","plugin":"{{.Slug}}"}`))
}
