# =============================================================================
# Shopanda — Environment Variables
# =============================================================================
# The config loader resolves .env relative to the chosen config file.
# When using configs/config.yaml, place this file at configs/.env.
# The loader also checks the working directory as a fallback, so .env
# in the project root works when you start the binary from there.
#
# Every variable here has a sensible default in configs/config.yaml.
# Env vars take precedence over YAML values.
#
# ⚠  PRODUCTION NOTE
# .env is a convenience for LOCAL DEVELOPMENT.
# In production, use configs/config.yaml or export variables in your shell
# before starting the binary — no containers or service managers required.
# If you do use systemd, Docker, or k8s, their env injection works too.
# The application logs a warning at startup when a .env file is detected.
#
# You can also set DATABASE_URL for a full PostgreSQL DSN:
#   DATABASE_URL=postgres://user:pass@host:5432/shopanda?sslmode=disable
# =============================================================================

# === Server ===
SHOPANDA_SERVER_HOST=0.0.0.0
SHOPANDA_SERVER_PORT=8080
# Public URL clients use to reach this server (required when host is 0.0.0.0).
# Defaults scheme to https if omitted. No trailing slash.
SHOPANDA_SERVER_PUBLIC_BASE_URL=https://shop.example.com

# === HTTP boundary ===
# Default JSON/API body cap (bytes). Media uploads use MEDIA_MAX_BODY_BYTES.
# SHOPANDA_HTTP_MAX_BODY_BYTES=1048576
# SHOPANDA_HTTP_MEDIA_MAX_BODY_BYTES=10485760

# === Database (PostgreSQL) ===
SHOPANDA_DATABASE_HOST=localhost
SHOPANDA_DATABASE_PORT=5432
SHOPANDA_DATABASE_USER=shopanda
# Leave empty for install.sh / production (installer auto-generates). Compose still
# injects changeme with SHOPANDA_DEV_MODE=true for local containers.
SHOPANDA_DATABASE_PASSWORD=
SHOPANDA_DATABASE_NAME=shopanda
# Leave unset so `docker compose` can default to disable (non-TLS postgres image).
# Bare-metal / install.sh default to require. Production: require|verify-ca|verify-full.
# SHOPANDA_DATABASE_SSLMODE=require

# === Logging ===
# Levels: debug, info, warn, error
# Formats: json, text
SHOPANDA_LOG_LEVEL=info
SHOPANDA_LOG_FORMAT=json

# === Authentication ===
# REQUIRED — app refuses to start without a strong secret (≥32 bytes).
# Canonical generate: openssl rand -hex 32 (64 hex chars stored as-is; not decoded).
# Trailing newlines/whitespace are trimmed.
SHOPANDA_AUTH_JWT_SECRET=
# Token lifetime (Go duration: 24h, 720h, etc.)
SHOPANDA_AUTH_JWT_TTL=24h

# === Mail (SMTP) ===
SHOPANDA_MAIL_DRIVER=smtp
SHOPANDA_MAIL_SMTP_HOST=localhost
SHOPANDA_MAIL_SMTP_PORT=587
SHOPANDA_MAIL_SMTP_USER=
SHOPANDA_MAIL_SMTP_PASSWORD=
SHOPANDA_MAIL_SMTP_FROM=noreply@example.com

# === Media Storage ===
# Drivers: local (default), s3 (future)
SHOPANDA_MEDIA_STORAGE=local
SHOPANDA_MEDIA_LOCAL_BASE_PATH=./public/media
SHOPANDA_MEDIA_LOCAL_BASE_URL=/media

# === Cache ===
# Drivers: postgres (default), redis (PR-414)
SHOPANDA_CACHE_DRIVER=postgres
# REDIS_URL=redis://localhost:6379/0
# SHOPANDA_CACHE_REDIS_URL=redis://localhost:6379/0
# SHOPANDA_CACHE_REDIS_KEY_PREFIX=shopanda

# === Queue (background jobs) ===
# Drivers: postgres (default), redis (PR-415), rabbitmq (PR-416)
SHOPANDA_QUEUE_DRIVER=postgres
# SHOPANDA_QUEUE_REDIS_URL=redis://localhost:6379/0
# SHOPANDA_QUEUE_REDIS_KEY_PREFIX=shopanda:queue
# SHOPANDA_QUEUE_RABBITMQ_URL=amqp://shopanda:changeme@localhost:5672/
# RABBITMQ_URL=amqp://shopanda:changeme@localhost:5672/
# SHOPANDA_QUEUE_RABBITMQ_QUEUE_PREFIX=shopanda

# === Frontend (optional SSR storefront) ===
SHOPANDA_FRONTEND_ENABLED=false
SHOPANDA_FRONTEND_MODE=ssr
SHOPANDA_FRONTEND_THEME_PATH=themes/default

# === CDN (optional) ===
# When set, asset URLs use this as base instead of local paths.
SHOPANDA_CDN_BASE_URL=

# === Example external plugin (plugins/example) ===
# SHOPANDA_PLUGINS_EXAMPLE_ENABLED=false
# SHOPANDA_PLUGINS_EXAMPLE_FEE_MINOR_UNITS=100

# === Webhooks ===
# Per-provider secrets. Replace PROVIDER with uppercase provider name.
# SHOPANDA_WEBHOOKS_SECRET_STRIPE=whsec_...
# SHOPANDA_WEBHOOKS_SECRET_PAYPAL=...

# === Rate Limiting (enabled by default) ===
SHOPANDA_RATE_LIMIT_ENABLED=true
# Tokens per second
SHOPANDA_RATE_LIMIT_DEFAULT_RATE=10
# Max burst (concurrent requests)
SHOPANDA_RATE_LIMIT_DEFAULT_BURST=20

# === Auth login lockout (enabled by default) ===
# store=cache uses cache.driver (postgres/redis) — use for multi-instance.
# store=memory is single-instance only.
SHOPANDA_AUTH_LOCKOUT_ENABLED=true
SHOPANDA_AUTH_LOCKOUT_STORE=cache
SHOPANDA_AUTH_LOCKOUT_MAX_FAILURES=10
SHOPANDA_AUTH_LOCKOUT_WINDOW=15m

# === Seeding (used only by `app seed`) ===
# Leave empty to skip admin user creation during seeding. Set a strong, unique
# password to have `app seed` create admin@example.com with it. There is no
# default password; never ship a guessable value here.
SHOPANDA_SEED_ADMIN_PASSWORD=

# === Development ===
# Truthy values: 1 / true / yes (case-insensitive). Absent/empty/0/false/no = off.
# Leave unset for production. Local docker compose injects SHOPANDA_DEV_MODE=true
# so default changeme + sslmode=disable work inside the compose network.
# For bare-metal local runs with changeme/sslmode=disable, uncomment:
# SHOPANDA_DEV_MODE=true
# Explicit opt-in to log plaintext password-reset tokens (also needs DEV_MODE).
# SHOPANDA_DEV_LOG_RESET_TOKENS=1
# SHOPANDA_DEV_EMBED_SCHEDULER=true

# === Testing ===
# PostgreSQL DSN for integration tests (tests skip if unset).
# CI (PR-1003 / job "CI / integration") uses the same shape against a Postgres 17
# service: user/password/db shopanda/shopanda/shopanda_test, sslmode=disable.
# SHOPANDA_TEST_DSN=postgres://shopanda:shopanda@localhost:5432/shopanda_test?sslmode=disable
